---
import Base from '../../layouts/Base.astro';
import SearchPosts from '../../components/SearchPosts.tsx';
import { getPosts, toSummary, type PostSummary } from '../../lib/wp';

let posts: PostSummary[] = [];
let error: string | null = null;

try {
  posts = (await getPosts(12)).map(toSummary);
} catch (err) {
  error = err instanceof Error ? err.message : 'Unknown error';
}
---

<Base
  title="Posts — Astro + WordPress Headless"
  description="All posts pulled from the WordPress REST API and pre-rendered with Astro, with a client-side React filter."
>
  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2>All posts</h2>
        <p>{posts.length} posts from WordPress</p>
      </div>

      {
        error ? (
          <p class="empty">
            Could not reach the WordPress API. Check <code>WP_API_URL</code> and rebuild.
          </p>
        ) : (
          <SearchPosts posts={posts} client:load />
        )
      }
    </div>
  </section>
</Base>

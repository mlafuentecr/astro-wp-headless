---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — astro·wp" description="The page you are looking for does not exist.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page does not exist.</h1>
      <p class="lede">The link may be outdated or the post may have been removed in WordPress.</p>
      <p style="margin-top:2rem"><a href="/">← Back home</a></p>
    </div>
  </section>
</Base>

---
import { WP_API_BASE } from '../lib/wp';

const year = new Date().getFullYear();
const sourceLabel = WP_API_BASE.replace(/^https?:\/\//, '').replace(/\/wp-json\/?$/, '');
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p style="margin:0">
      Built with <a href="https://astro.build" rel="noopener">Astro</a> + React islands, consuming
      WordPress over its REST API.
    </p>
    <p style="margin:0">
      Content source: <code>{sourceLabel}</code> · {year}
    </p>
  </div>
</footer>
